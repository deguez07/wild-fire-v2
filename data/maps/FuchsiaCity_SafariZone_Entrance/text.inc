FuchsiaCity_SafariZone_Entrance_Text_ClosedDueToRockSlide::
    .string "Sorry! The SAFARI ZONE entrance\n"
    .string "is temporarily closed.\p"
    .string "A ROCK SLIDE blocked the path,\n"
    .string "and we're still clearing it.\p"
    .string "To visit, please use the WARP\n"
    .string "PANEL in the ROUTE 22 gate,\l"
    .string "west of VIRIDIAN CITY.$"

FuchsiaCity_SafariZone_Entrance_Text_WelcomeAdmissionIsFree::
    .string "Welcome to the SAFARI ZONE!\p"
    .string "Admission is free now, so feel\n"
    .string "free to explore!$"

FuchsiaCity_SafariZone_Entrance_Text_UseRoute22WarpPanel::
    .string "But this entrance is closed until\n"
    .string "the ROCK SLIDE is cleared.\p"
    .string "Please use the WARP PANEL in the\n"
    .string "ROUTE 22 gate for now.$"

FuchsiaCity_SafariZone_Entrance_Text_FirstTimeAtSafariZone::
    .string "Hi! Is it your first time here at\n"
    .string "the SAFARI ZONE?$"

FuchsiaCity_SafariZone_Entrance_Text_ExplainSafariZone::
    .string "The SAFARI ZONE actually has\n"
    .string "four zones in it.\p"
    .string "Each zone has different kinds of\n"
    .string "POKéMON, even some rare ones.\p"
    .string "Wild POKéMON here battle just like\n"
    .string "anywhere else, so bring your own\l"
    .string "POKé BALLS and a strong team!$"

FuchsiaCity_SafariZone_Entrance_Text_SorryYoureARegularHere::
    .string "Sorry, you're a regular here!$"
