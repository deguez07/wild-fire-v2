FuchsiaCity_SafariZone_Entrance_MapScripts::
	.byte 0

FuchsiaCity_SafariZone_Entrance_EventScript_RockSlideGuard::
	msgbox FuchsiaCity_SafariZone_Entrance_Text_ClosedDueToRockSlide, MSGBOX_NPC
	end

FuchsiaCity_SafariZone_Entrance_EventScript_CounterAttendant::
	lock
	faceplayer
	msgbox FuchsiaCity_SafariZone_Entrance_Text_WelcomeAdmissionIsFree
	goto_if_set FLAG_SYS_GAME_CLEAR, FuchsiaCity_SafariZone_Entrance_EventScript_CounterAttendantEnd
	msgbox FuchsiaCity_SafariZone_Entrance_Text_UseRoute22WarpPanel
FuchsiaCity_SafariZone_Entrance_EventScript_CounterAttendantEnd::
	release
	end

FuchsiaCity_SafariZone_Entrance_EventScript_InfoAttendant::
	lock
	faceplayer
	msgbox FuchsiaCity_SafariZone_Entrance_Text_FirstTimeAtSafariZone, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, FuchsiaCity_SafariZone_Entrance_EventScript_ExplainSafariZone
	msgbox FuchsiaCity_SafariZone_Entrance_Text_SorryYoureARegularHere
	release
	end

FuchsiaCity_SafariZone_Entrance_EventScript_ExplainSafariZone::
	msgbox FuchsiaCity_SafariZone_Entrance_Text_ExplainSafariZone
	release
	end
